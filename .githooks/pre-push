#!/bin/sh
set -eu

# The default branch advances only through merged pull requests. The one
# exception is the push that creates it on a brand-new remote.

remote="$1"
default="$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s|^refs/remotes/$remote/||")" || default=""
[ -n "$default" ] || default="$(git config init.defaultBranch || echo main)"

# scripts/agent records the commit it last checked in full, with a clean tree.
recorded="$(cat "$(git rev-parse --git-dir)/agent-checked" 2>/dev/null || :)"
branches=0
unchecked=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/$default" ] && git ls-remote --exit-code --heads "$remote" "$default" >/dev/null 2>&1; then
        echo "pre-push: refusing to push to $default; open a pull request (scripts/agent pr)" >&2
        exit 1
    fi
    case "$remote_ref" in
    refs/heads/*)
        branches=$((branches + 1))
        [ "$local_sha" = "$recorded" ] || unchecked=$((unchecked + 1))
        ;;
    esac
done

# A tag points at a merge commit CI already checked; checking the working tree again would test
# whatever happens to be checked out, not what's tagged.
[ "$branches" -gt 0 ] || exit 0

# The same check already passed on exactly this commit; running it twice only doubles the wait.
if [ "$unchecked" -eq 0 ]; then
    echo "pre-push: $recorded was checked by scripts/agent"
    exit 0
fi

echo "pre-push: full check"
exec scripts/task check

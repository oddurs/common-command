#!/bin/sh
set -eu

# The one seam CI and git hooks call. Verbs: fmt fmt:check lint test build check, plus package and
# run. This file is the same in every Common Tools app; the values below come from
# standard/apps.json in oddurs/common-tools.

cd "$(dirname "$0")/.."

name="Common Command"
executable="CommonCommand"
bundle_id="com.oddurs.commoncommand"
asset="CommonCommand"
# Command-line tools built and shipped beside the app.
tools=""

sources="Package.swift Sources Tests scripts/make-icon.swift"
app="build/$name.app"
# The deployment target is written once, in Info.plist; the build follows it.
min_macos="$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' Resources/Info.plist)"

# Command Line Tools ship Swift Testing outside the default search paths;
# Xcode does not need this.
test_flags() {
    dev="$(xcode-select -p)"
    case "$dev" in
    */CommandLineTools)
        fw="$dev/Library/Developer/Frameworks"
        lib="$dev/Library/Developer/usr/lib"
        printf '%s\n' -Xswiftc -F -Xswiftc "$fw" -Xlinker -F -Xlinker "$fw" \
            -Xlinker -rpath -Xlinker "$fw" -Xlinker -rpath -Xlinker "$lib"
        ;;
    esac
}

# macOS ties permissions such as Accessibility, and login items, to the signature. A stable
# certificate keeps them across rebuilds; an ad-hoc signature changes every build. scripts/dev-cert
# makes one, shared by every Common Tools app.
sign() {
    identity="Common Tools Development"
    # Only a valid identity: one that's present but not trusted for code signing makes codesign fail.
    if security find-identity -v -p codesigning | grep -q "\"$identity\""; then
        echo "==> signing $1 with '$identity'"
        codesign --force --sign "$identity" --identifier "$2" --options runtime "$1"
    else
        echo "==> signing $1 ad-hoc; run scripts/dev-cert to keep permissions across rebuilds"
        codesign --force --sign - --identifier "$2" --options runtime "$1"
    fi
}

case "${1:-}" in
fmt)
    echo "==> formatting"
    # shellcheck disable=SC2086
    swift format --in-place --recursive $sources
    ;;
fmt:check)
    echo "==> checking format"
    # shellcheck disable=SC2086
    swift format lint --strict --recursive $sources
    ;;
lint)
    "$0" fmt:check
    echo "==> building with warnings as errors"
    swift build -Xswiftc -warnings-as-errors
    ;;
test)
    echo "==> running tests${2:+ matching $2}"
    # shellcheck disable=SC2046
    swift test $(test_flags) ${2:+--filter "$2"}
    ;;
build)
    # One build per architecture, joined with lipo: `--arch a --arch b`
    # needs Xcode's build system, which Command Line Tools lack.
    dirs=""
    for arch in arm64 x86_64; do
        triple="$arch-apple-macosx$min_macos"
        echo "==> building release for $arch"
        swift build -c release --triple "$triple"
        dirs="$dirs $(swift build -c release --triple "$triple" --show-bin-path)"
    done
    echo "==> assembling $app"
    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    # The bundle carries the product name; the executable keeps the target's name.
    # shellcheck disable=SC2086
    lipo -create $(for dir in $dirs; do echo "$dir/$executable"; done) -output "$app/Contents/MacOS/$executable"
    cp Resources/Info.plist "$app/Contents/"
    cp Resources/AppIcon.icns "$app/Contents/Resources/"
    # The Common Tools section of Settings shows every app's icon from here.
    cp -R Resources/CommonTools "$app/Contents/Resources/"
    sign "$app" "$bundle_id"
    echo "==> built $app"
    for tool in $tools; do
        # shellcheck disable=SC2046
        lipo -create $(for dir in $dirs; do echo "$dir/$tool"; done) -output "build/$tool"
        sign "build/$tool" "$tool"
        echo "==> built build/$tool"
    done
    ;;
package)
    # What a release publishes. The names carry no version, so
    # releases/latest/download/<name>.zip always gets the newest.
    [ -d "$app" ] || "$0" build
    echo "==> packaging into dist/"
    rm -rf dist
    mkdir dist
    # ditto keeps the bundle's signature and extended attributes intact.
    ditto -c -k --keepParent "$app" "dist/$asset.zip"
    for tool in $tools; do ditto -c -k "build/$tool" "dist/$tool.zip"; done
    for zip in dist/*.zip; do (cd dist && shasum -a 256 "${zip#dist/}" >"${zip#dist/}.sha256"); done
    ls -l dist
    ;;
run)
    "$0" build
    echo "==> relaunching $name"
    # By process name: a fresh build isn't registered with Launch Services yet, so AppleScript
    # can't always find it by bundle identifier.
    if pgrep -x "$executable" >/dev/null; then
        pkill -x "$executable"
        while pgrep -x "$executable" >/dev/null; do sleep 0.2; done
    fi
    open "$app"
    ;;
check)
    "$0" lint
    "$0" test
    "$0" build
    ;;
*)
    echo "usage: scripts/task {fmt|fmt:check|lint|test [name]|build|package|run|check}" >&2
    exit 2
    ;;
esac
